# Used only by the opt-in generation service. Gameplay does not need credentials.
FAL_KEY=

# Deploy destination for deploy.sh / db scripts (rsync-style user@host:/path)
DEPLOY_TARGET=

# Public URL the app is served at (drives the nginx snippet; may include a subpath)
DEPLOY_URL=

# Host port the deploy container publishes on 127.0.0.1 (nginx proxies to it)
PORT=

# Optional global asset cache reset. Keep stable; changed files version themselves.
ASSET_CACHE_VERSION=1
